<mujoco model="EarlyBots bathroom restocking demo">
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default><geom condim="3" friction="0.9 0.08 0.03"/></default>
  <visual><global azimuth="135" elevation="-24"/></visual>
  <statistic center="-0.1 0 0.75" extent="1.5"/>
  <worldbody>
    <light pos="-1 -1 3" dir="0.4 0.4 -1" diffuse="0.9 0.9 0.9"/>
    <!-- Overhead RGB camera: +X right, +Y up, -Z forward. -->
    <camera name="overhead" pos="0 0 1.75" xyaxes="1 0 0 0 1 0" fovy="60"/>
    <geom name="floor" type="plane" size="3 3 0.05" rgba="0.80 0.83 0.85 1"/>
    <body name="counter" pos="0 0 0.73">
      <geom name="countertop" type="box" size="0.67 0.42 0.06" rgba="0.94 0.94 0.91 1"/>
      <geom type="box" pos="0 -0.39 -0.33" size="0.65 0.025 0.26" rgba="0.66 0.72 0.74 1"/>
      <geom type="box" pos="-0.61 0 -0.33" size="0.025 0.38 0.26" rgba="0.72 0.76 0.78 1"/>
    </body>
    <body name="tray" pos="0.26 0.05 0.809">
      <geom type="box" size="0.20 0.18 0.013" rgba="0.18 0.30 0.35 1"/>
      <geom type="box" pos="-0.207 0 0.041" size="0.008 0.187 0.041" rgba="0.18 0.30 0.35 1"/>
      <geom type="box" pos="0.207 0 0.041" size="0.008 0.187 0.041" rgba="0.18 0.30 0.35 1"/>
      <geom type="box" pos="0 0.187 0.041" size="0.207 0.008 0.041" rgba="0.18 0.30 0.35 1"/>
      <geom type="box" pos="0 -0.187 0.041" size="0.207 0.008 0.041" rgba="0.18 0.30 0.35 1"/>
      <geom name="toothpaste" type="capsule" fromto="0.12 0.08 0.035 0.12 -0.055 0.035" size="0.018" rgba="0.80 0.97 0.95 1" contype="0" conaffinity="0"/>
      <geom name="toothbrush" type="capsule" fromto="-0.075 0.075 0.03 -0.075 -0.09 0.03" size="0.007" rgba="0.25 0.78 0.86 1" contype="0" conaffinity="0"/>
      <geom name="toothbrush_head" type="box" pos="-0.075 0.09 0.035" size="0.014 0.023 0.007" rgba="0.96 0.96 0.99 1" contype="0" conaffinity="0"/>
    </body>
    <body name="soap" pos="-0.27 0.005 0.812">
      <freejoint name="soap_free"/>
      <!-- Start with flat-sided soap: flat sides allow realistic normal gripping forces. -->
      <geom name="soap_geom" type="box" size="0.075 0.05 0.022" density="450" rgba="0.98 0.74 0.20 1"/>
    </body>
    <body name="robot_base" pos="-0.76 -0.37 0.11">
      <geom name="base" type="cylinder" size="0.16 0.105" rgba="0.17 0.22 0.26 1"/>
      <geom name="mast" type="box" pos="0 0 0.65" size="0.055 0.055 0.65" rgba="0.29 0.38 0.43 1"/>
      <geom name="head" type="box" pos="0 -0.012 1.13" size="0.12 0.11 0.115" rgba="0.15 0.20 0.25 1"/>
      <geom name="eye" type="box" pos="0 -0.128 1.15" size="0.079 0.008 0.032" rgba="0.15 0.82 0.96 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Tool root is still guided kinematically: ONLY the two jaws and the soap
         interact through actual MuJoCo contacts, forces and friction. -->
    <body name="gripper" mocap="true" pos="-0.42 -0.06 1.16">
      <geom name="tool_rod" type="capsule" fromto="0 0 0.015 0 0 0.17" size="0.016"
            rgba="0.28 0.39 0.44 1" contype="0" conaffinity="0"/>
      <geom name="tool_body" type="box" size="0.049 0.049 0.035"
            rgba="0.12 0.17 0.21 1" contype="0" conaffinity="0"/>
      <body name="left_finger" pos="0 -0.080 -0.119">
        <joint name="left_slide" type="slide" axis="0 1 0" range="0 0.080"
               damping="4" armature="0.001"/>
        <geom name="left_pad" type="box" size="0.046 0.010 0.022"
              density="400" friction="4.0 0.05 0.02" condim="4" priority="1"
              rgba="0.12 0.62 0.71 1"/>
      </body>
      <body name="right_finger" pos="0 0.080 -0.119">
        <joint name="right_slide" type="slide" axis="0 -1 0" range="0 0.080"
               damping="4" armature="0.001"/>
        <geom name="right_pad" type="box" size="0.046 0.010 0.022"
              density="400" friction="4.0 0.05 0.02" condim="4" priority="1"
              rgba="0.12 0.62 0.71 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="left_grip" joint="left_slide" kp="600" kv="35"
              ctrllimited="true" ctrlrange="0 0.080"
              forcelimited="true" forcerange="-25 25"/>
    <position name="right_grip" joint="right_slide" kp="600" kv="35"
              ctrllimited="true" ctrlrange="0 0.080"
              forcelimited="true" forcerange="-25 25"/>
  </actuator>
</mujoco>
