<mujoco model="EarlyBots mobile cube sorting research prototype">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" iterations="80"/>
  <default>
    <joint damping="2" armature="0.01"/>
    <geom condim="4" friction="1.2 0.01 0.001"/>
  </default>
  <visual><global azimuth="135" elevation="-25"/></visual>
  <statistic center="0 0 0.1" extent="2.9"/>
  <worldbody>
    <light name="sun" pos="-0.5 -1.0 3.2" dir="0.2 0.3 -1" diffuse="0.9 0.9 0.9"/>
    <camera name="overview" pos="0 0 3.7" xyaxes="1 0 0 0 1 0" fovy="54"/>
    <geom name="floor" type="plane" size="2.2 2.2 0.05" rgba="0.86 0.88 0.88 1"/>
    <geom name="back_boundary" type="box" pos="0 1.65 0.12" size="1.65 0.03 0.12" rgba="0.68 0.75 0.78 1"/>
    <geom name="left_boundary" type="box" pos="-1.65 0 0.12" size="0.03 1.65 0.12" rgba="0.68 0.75 0.78 1"/>
    <geom name="right_boundary" type="box" pos="1.65 0 0.12" size="0.03 1.65 0.12" rgba="0.68 0.75 0.78 1"/>
    <geom name="front_boundary" type="box" pos="0 -1.65 0.12" size="1.65 0.03 0.12" rgba="0.68 0.75 0.78 1"/>
    <!-- Physical blue open bin, inside dimensions 36 x 36 cm, wall height 11 cm. -->
    <body name="blue_bin" pos="0.95 0.90 0">
      <geom name="bin_base" type="box" pos="0 0 0.015" size="0.20 0.20 0.015" rgba="0.11 0.34 0.93 1"/>
      <geom name="bin_back" type="box" pos="0 0.192 0.073" size="0.20 0.008 0.058" rgba="0.10 0.29 0.78 1"/>
      <geom name="bin_front" type="box" pos="0 -0.192 0.073" size="0.20 0.008 0.058" rgba="0.10 0.29 0.78 1"/>
      <geom name="bin_left" type="box" pos="-0.192 0 0.073" size="0.008 0.184 0.058" rgba="0.10 0.29 0.78 1"/>
      <geom name="bin_right" type="box" pos="0.192 0 0.073" size="0.008 0.184 0.058" rgba="0.10 0.29 0.78 1"/>
    </body>
    <!-- LeKiwi-like holonomic mobile base: three omni wheels are *visual only*.
         X/Y/yaw sliders are actuated directly: no claim of wheel-contact fidelity. -->
    <body name="mobile_base" pos="0 0 0">
      <joint name="base_x" type="slide" axis="1 0 0" damping="9"/>
      <joint name="base_y" type="slide" axis="0 1 0" damping="9"/>
      <joint name="base_yaw" type="hinge" axis="0 0 1" damping="2"/>
      <geom name="chassis" type="cylinder" pos="0 0 0.16" size="0.17 0.045" mass="2.8" rgba="0.95 0.95 0.94 1" contype="1" conaffinity="1"/>
      <geom name="deck" type="cylinder" pos="0 0 0.23" size="0.126 0.02" mass="0.25" rgba="0.12 0.16 0.20 1"/>
      <geom name="wheel_a" type="cylinder" pos="0.15 0 0.075" euler="1.5708 0 0" size="0.075 0.030" rgba="0.18 0.20 0.23 1" contype="0" conaffinity="0" mass="0.08"/>
      <geom name="wheel_b" type="cylinder" pos="-0.075 0.13 0.075" euler="1.5708 0 2.0944" size="0.075 0.030" rgba="0.18 0.20 0.23 1" contype="0" conaffinity="0" mass="0.08"/>
      <geom name="wheel_c" type="cylinder" pos="-0.075 -0.13 0.075" euler="1.5708 0 -2.0944" size="0.075 0.030" rgba="0.18 0.20 0.23 1" contype="0" conaffinity="0" mass="0.08"/>
      <geom name="mast" type="capsule" fromto="-0.07 0 0.23 -0.07 0 0.56" size="0.018" mass="0.15" rgba="0.73 0.77 0.79 1" contype="0" conaffinity="0"/>
      <geom name="robot_eye" type="box" pos="-0.065 -0.035 0.56" size="0.025 0.04 0.025" rgba="0.06 0.58 0.67 1" contype="0" conaffinity="0" mass="0.02"/>
      <camera name="front" pos="0.08 0 0.59" xyaxes="0 1 0 -0.7071 0 -0.7071" fovy="70"/>
      <!-- Deliberately simplified 2-DOF Cartesian arm, NOT an SO-101 model. -->
      <body name="reach_stage" pos="0 0 0.50">
        <joint name="reach" type="slide" axis="1 0 0" range="0.06 0.38" limited="true" damping="5"/>
        <geom name="reach_rail" type="capsule" fromto="-0.13 0 0 0.02 0 0" size="0.018" mass="0.22" rgba="0.68 0.75 0.77 1" contype="0" conaffinity="0"/>
        <body name="lift_stage">
          <joint name="lift" type="slide" axis="0 0 1" range="-0.475 0.08" limited="true" damping="5"/>
          <geom name="vertical_carriage" type="capsule" fromto="0 0 0.035 0 0 0.18" size="0.018" mass="0.24" rgba="0.55 0.69 0.74 1" contype="0" conaffinity="0"/>
          <geom name="jaw_housing" type="box" pos="0 0 0.038" size="0.036 0.031 0.020" mass="0.08" rgba="0.16 0.23 0.28 1" contype="0" conaffinity="0"/>
          <camera name="wrist" pos="0.075 0 0.065" xyaxes="0 1 0 -0.7071 0 -0.7071" fovy="80"/>
          <body name="finger_left" pos="0 -0.075 0">
            <joint name="left_jaw" type="slide" axis="0 1 0" range="0 0.055" limited="true" damping="2"/>
            <geom name="left_pad" type="box" size="0.024 0.008 0.021" mass="0.025" friction="3.5 0.01 0.002" rgba="0.08 0.75 0.80 1"/>
          </body>
          <body name="finger_right" pos="0 0.075 0">
            <joint name="right_jaw" type="slide" axis="0 -1 0" range="0 0.055" limited="true" damping="2"/>
            <geom name="right_pad" type="box" size="0.024 0.008 0.021" mass="0.025" friction="3.5 0.01 0.002" rgba="0.08 0.75 0.80 1"/>
          </body>
        </body>
      </body>
    </body>
    <body name="red_0" pos="-0.73 -0.86 0.025">
      <freejoint name="cube_0"/><geom name="cube_geom_0" type="box" size="0.024 0.024 0.024" mass="0.045" rgba="0.94 0.10 0.09 1" friction="2.4 0.01 0.002"/>
    </body>
    <body name="red_1" pos="-0.35 0.42 0.025">
      <freejoint name="cube_1"/><geom name="cube_geom_1" type="box" size="0.024 0.024 0.024" mass="0.045" rgba="0.94 0.10 0.09 1" friction="2.4 0.01 0.002"/>
    </body>
    <body name="red_2" pos="0.42 -0.68 0.025">
      <freejoint name="cube_2"/><geom name="cube_geom_2" type="box" size="0.024 0.024 0.024" mass="0.045" rgba="0.94 0.10 0.09 1" friction="2.4 0.01 0.002"/>
    </body>
    <body name="red_3" pos="-0.86 0.77 0.025">
      <freejoint name="cube_3"/><geom name="cube_geom_3" type="box" size="0.024 0.024 0.024" mass="0.045" rgba="0.94 0.10 0.09 1" friction="2.4 0.01 0.002"/>
    </body>
    <body name="red_4" pos="0.50 0.18 0.025">
      <freejoint name="cube_4"/><geom name="cube_geom_4" type="box" size="0.024 0.024 0.024" mass="0.045" rgba="0.94 0.10 0.09 1" friction="2.4 0.01 0.002"/>
    </body>
  </worldbody>
  <actuator>
    <position name="drive_x" joint="base_x" kp="550" kv="85" forcelimited="true" forcerange="-110 110"/>
    <position name="drive_y" joint="base_y" kp="550" kv="85" forcelimited="true" forcerange="-110 110"/>
    <position name="drive_yaw" joint="base_yaw" kp="100" kv="20" forcelimited="true" forcerange="-45 45"/>
    <position name="arm_reach" joint="reach" kp="400" kv="45" forcelimited="true" forcerange="-70 70"/>
    <position name="arm_lift" joint="lift" kp="550" kv="65" forcelimited="true" forcerange="-90 90"/>
    <position name="jaw_left" joint="left_jaw" kp="300" kv="20" forcelimited="true" forcerange="-15 15"/>
    <position name="jaw_right" joint="right_jaw" kp="300" kv="20" forcelimited="true" forcerange="-15 15"/>
  </actuator>
</mujoco>